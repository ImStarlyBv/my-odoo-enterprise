<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Regla multi-compañía para account.fiscal.sequence.
         Filtra los registros de forma que cada usuario solo vea las
         secuencias que pertenecen a las compañías a las que tiene acceso. -->
    <record id="ir_rule_fiscal_sequence_company" model="ir.rule">
        <field name="name">Secuencia Fiscal: filtro multi-compañía</field>
        <field name="model_id" ref="model_account_fiscal_sequence"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
