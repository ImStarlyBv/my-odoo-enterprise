<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!-- Cron diario que expira secuencias fiscales vencidas.
         Ejecuta account.fiscal.sequence._expire_sequences() a medianoche. -->
    <record id="account_fiscal_sequence_expire_cron" model="ir.cron">
        <field name="name">[FISCAL] Expirar secuencias vencidas</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="nextcall"
               eval="(datetime.now()).replace(hour=0, minute=0, second=0, microsecond=0)"/>
        <field name="model_id" ref="model_account_fiscal_sequence"/>
        <field name="state">code</field>
        <field name="code">model._expire_sequences()</field>
    </record>

</odoo>
