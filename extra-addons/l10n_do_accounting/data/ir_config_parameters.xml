<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!-- Habilita la consulta web al webservice móvil de la DGII para
         validar RNC/cédula. Cambiar a False para deshabilitar la consulta. -->
    <record id="query_dgii_parameter" model="ir.config_parameter" forcecreate="0">
        <field name="key">dgii.wsmovil</field>
        <field name="value">True</field>
    </record>

</odoo>
