<odoo>
    <record id="view_company_form_inherited_digifact" model="ir.ui.view">
        <field name="name">res.company.form.inherited.digifact</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="digifact_config" string="DigiFact / e-CF">
                    <group>
                        <group string="Configuración de Envío">
                            <field name="is_live" widget="boolean_toggle"/>
                            <field name="l10n_do_default_client"/>
                        </group>
                        <group string="Datos del Emisor">
                            <field name="l10n_do_trade_name"/>
                            <field name="l10n_do_economic_activity"/>
                            <field name="l10n_do_branch_code"/>
                            <field name="l10n_do_municipality_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
