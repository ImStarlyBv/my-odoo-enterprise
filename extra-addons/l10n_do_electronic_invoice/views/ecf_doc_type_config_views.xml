<odoo>
    <!-- Vista principal: todos los tipos e-CF con toggle send_to_dgii -->
    <record id="view_ecf_doc_type_config_tree" model="ir.ui.view">
        <field name="name">l10n_do.ecf.doc.type.config.tree</field>
        <field name="model">l10n_do.ecf.doc.type.config</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="doc_type"/>
                <field name="send_to_dgii" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

</odoo>
