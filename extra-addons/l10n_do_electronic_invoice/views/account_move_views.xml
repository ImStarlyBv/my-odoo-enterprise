<odoo>
    <!-- Botón "Previsualizar JSON e-CF" en la vista formulario de factura -->
    <record id="view_move_form_inherited_digifact" model="ir.ui.view">
        <field name="name">account.move.form.inherited.digifact</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Botón en la cabecera de la factura -->
            <xpath expr="//header" position="inside">
                <button name="action_preview_digifact_json"
                        type="object"
                        string="Ver JSON e-CF"
                        class="btn-secondary"
                        invisible="not is_ecf_invoice"/>
            </xpath>

            <!-- Campos adicionales en la pestaña 'Otra Info' -->
            <xpath expr="//page[@id='other_tab']//group[@id='other_tab_group_1']" position="inside">
                <group string="Facturación Electrónica (DigiFact)" invisible="not is_ecf_invoice">
                    <field name="l10n_do_payment_type"/>
                    <field name="l10n_do_indicador_monto_gravado"/>
                    <field name="l10n_do_seller_code"/>
                    <field name="l10n_do_purchase_order_number"/>
                    <field name="l10n_do_sales_zone"/>
                    <field name="l10n_do_sales_route"/>
                    <field name="l10n_do_additional_seller_info"/>
                    <field name="l10n_do_modification_reason"
                           invisible="move_type != 'out_refund'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
