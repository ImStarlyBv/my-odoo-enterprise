<odoo>
    <record id="view_document_type_form_ecf_inherited" model="ir.ui.view">
        <field name="name">l10n_latam.document.type.form.ecf</field>
        <field name="model">l10n_latam.document.type</field>
        <field name="inherit_id" ref="l10n_latam_invoice_document.view_document_type_form"/>
        <field name="arch" type="xml">

            <!-- Habilitar edicion para guardar los campos ECF -->
            <xpath expr="//form" position="attributes">
                <attribute name="edit">1</attribute>
            </xpath>

            <!-- Campos invisibles cargados antes del group para que las condiciones
                 de los banners funcionen aunque el grupo este oculto (code != E). -->
            <xpath expr="//group" position="before">
                <field name="ecf_sequence_max" invisible="1"/>
                <field name="ecf_sequence_status" invisible="1"/>
                <field name="ecf_remaining_sequences" invisible="1"/>

                <!-- Sin configurar -->
                <div class="alert alert-warning mb-0 rounded-0 border-0 border-bottom"
                     role="alert"
                     invisible="code != &apos;E&apos; or ecf_sequence_max != 0">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    <strong>Sin configurar.</strong>
                    Ingresa el ultimo NCF autorizado por la DGII para activar
                    el control de comprobantes y las alertas en facturas.
                </div>

                <!-- Agotado -->
                <div class="alert alert-danger mb-0 rounded-0 border-0 border-bottom"
                     role="alert"
                     invisible="code != &apos;E&apos; or ecf_sequence_status != &apos;exhausted&apos;">
                    <i class="fa fa-ban me-1"/>
                    <strong>Comprobantes agotados.</strong>
                    Solicita un nuevo bloque de NCF a la DGII antes de emitir mas facturas.
                </div>

                <!-- Pocos -->
                <div class="alert alert-warning mb-0 rounded-0 border-0 border-bottom"
                     role="alert"
                     invisible="code != &apos;E&apos; or ecf_sequence_status != &apos;low&apos;">
                    <i class="fa fa-exclamation-circle me-1"/>
                    <strong>Pocos comprobantes disponibles.</strong>
                    Quedan <field name="ecf_remaining_sequences" readonly="1" class="d-inline fw-bold"/> — solicita renovacion pronto.
                </div>
            </xpath>

            <!-- NOTA: usa `code` (valor E), NO doc_code_prefix (que contiene E31, E32...) -->
            <xpath expr="//group" position="after">
                <group string="Secuencia NCF (e-CF)" invisible="code != &apos;E&apos;">
                    <group>
                        <field name="ecf_sequence_max"/>
                        <field name="ecf_warning_threshold"/>
                    </group>
                    <group invisible="ecf_sequence_max == 0">
                        <field name="ecf_last_used_sequence" readonly="1"/>
                        <field name="ecf_remaining_sequences" readonly="1"/>
                        <field name="ecf_sequence_status" readonly="1"
                               widget="badge"
                               decoration-success="ecf_sequence_status == &apos;ok&apos;"
                               decoration-warning="ecf_sequence_status == &apos;low&apos;"
                               decoration-danger="ecf_sequence_status == &apos;exhausted&apos;"
                               decoration-muted="ecf_sequence_status == &apos;unconfigured&apos;"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>
</odoo>
