<odoo>
    <record id="view_partner_form_l10n_do_municipality" model="ir.ui.view">
        <field name="name">res.partner.form.l10n_do.municipality</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Ocultar ciudad libre cuando es RD (se usa el municipio) -->
            <xpath expr="//field[@name='city']" position="attributes">
                <attribute name="invisible">country_code == 'DO'</attribute>
            </xpath>

            <!-- Municipio DGII justo después del campo ciudad -->
            <xpath expr="//field[@name='city']" position="after">
                <field name="l10n_do_municipality_id"
                       placeholder="Municipio..."
                       class="o_address_city"
                       options="{'no_open': True, 'no_create': True}"
                       invisible="country_code != 'DO'"/>
            </xpath>

        </field>
    </record>

    <!-- Acción de servidor para sincronizar municipios desde la lista de contactos -->
    <record id="action_sync_legacy_municipalities" model="ir.actions.server">
        <field name="name">Sincronizar Municipios DGII</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            <![CDATA[
target_partners = records.filtered(
    lambda p: p.country_code == 'DO' and p.city and not p.l10n_do_municipality_id
)
for partner in target_partners:
    domain = [('name', '=ilike', partner.city)]
    if partner.state_id:
        domain.append(('state_id', '=', partner.state_id.id))
    municipio = env['l10n_do.municipality'].search(domain, limit=1)
    if municipio:
        partner.write({'l10n_do_municipality_id': municipio.id})
            ]]>
        </field>
    </record>
</odoo>
