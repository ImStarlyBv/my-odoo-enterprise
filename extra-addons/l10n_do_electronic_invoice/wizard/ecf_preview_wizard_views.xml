<odoo>
    <record id="ecf_preview_wizard_form" model="ir.ui.view">
        <field name="name">l10n_do.ecf.preview.wizard.form</field>
        <field name="model">l10n_do.ecf.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Previsualizar JSON e-CF">
                <group>
                    <field name="json_preview"
                           nolabel="1"
                           widget="text"
                           style="height: 450px; font-family: monospace; white-space: pre-wrap;"/>
                </group>
                <footer>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ecf_preview_wizard" model="ir.actions.act_window">
        <field name="name">JSON de Factura Electrónica (e-CF)</field>
        <field name="res_model">l10n_do.ecf.preview.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
