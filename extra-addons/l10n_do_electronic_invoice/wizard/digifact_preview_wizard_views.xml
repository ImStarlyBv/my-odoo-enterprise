<odoo>
    <record id="digifact_preview_wizard_form" model="ir.ui.view">
        <field name="name">digifact.preview.wizard.form</field>
        <field name="model">digifact.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Previsualizar JSON e-CF">
                <group>
                    <field name="json_preview" nolabel="1" widget="text" 
                        html="True" 
                        style="height: 400px; font-family: monospace; white-space: pre-wrap;" />
                </group>
                <footer>
                    <button name="action_send_to_digifact" type="object" string="Enviar a DigiFact" class="btn-primary" invisible="1"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_digifact_preview_wizard" model="ir.actions.act_window">
        <field name="name">JSON de Factura Electrónica (e-CF)</field>
        <field name="res_model">digifact.preview.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
