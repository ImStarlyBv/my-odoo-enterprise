<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_res_config_settings_inherit_dgii" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.dgii</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//app[@name='account']" position="inside">
                
                <block title="DGII" id="l10n_do_dgii_settings">
                    
                    <setting id="l10n_do_is_subject_to_proportionality_setting" 
                             help="All purchase invoices will be subject to proportionality."
                             title="Subject to Proportionality">
                        
                        <field name="l10n_do_is_subject_to_proportionality"/>
                        
                        <div class="mt-2">
                            <span class="fa fa-lg fa-balance-scale text-primary me-2" 
                                  title="Proportionality Scale" 
                                  aria-label="Scale Icon" 
                                  role="img"/>
                            <strong>Nota:</strong> Configuración fiscal requerida.
                        </div>
                    </setting>
                    
                </block>
            </xpath>
            
        </field>
    </record>
</odoo>