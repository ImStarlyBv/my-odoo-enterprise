<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="point_of_sale.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">

        <!-- Datos del cliente (RNC/Cédula, dirección) después del ReceiptHeader -->
        <xpath expr="//ReceiptHeader" position="after">
            <t t-if="props.data.l10n_do_is_fiscal and props.data.partner">
                <div class="pos-receipt-font-75">
                    <br/>
                    <div>Cliente: <t t-esc="props.data.partner.name"/></div>
                    <div t-if="props.data.partner.vat">
                        RNC / Cédula: <t t-esc="props.data.partner.vat"/>
                    </div>
                    <div t-if="props.data.partner.street">
                        <t t-esc="props.data.partner.street"/>
                        <t t-if="props.data.partner.street2"
                           t-esc="', ' + props.data.partner.street2"/>
                    </div>
                    <div t-if="props.data.partner.city">
                        <t t-esc="props.data.partner.city"/>
                    </div>
                </div>
            </t>

            <!-- Sección fiscal: autorización DGII + NCF / e-CF -->
            <t t-if="props.data.l10n_do_is_fiscal and props.data.l10n_do_fiscal_number">
                <br/>
                <div class="pos-receipt-contact text-center">
                    Autorizado por la DGII
                </div>
                <div class="pos-receipt-font-75">
                    <div>
                        Tipo: <t t-esc="props.data.document_type and props.data.document_type.name or ''"/>
                    </div>
                    <div>
                        <t t-if="props.data.is_ecf">e-CF</t><t t-else="">NCF</t>:
                        <strong><t t-esc="props.data.l10n_do_fiscal_number"/></strong>
                    </div>
                    <div t-if="props.data.l10n_do_ncf_expiration_date">
                        Válido hasta: <t t-esc="props.data.l10n_do_ncf_expiration_date"/>
                    </div>
                    <div t-if="props.data.l10n_do_origin_ncf">
                        NCF afectado: <t t-esc="props.data.l10n_do_origin_ncf"/>
                    </div>
                </div>

                <!-- QR y código de seguridad — solo para e-CF (E3x) -->
                <t t-if="props.data.is_ecf">
                    <div t-if="props.data.ecf_qr_image" class="text-center do-pos-receipt-ecf-qr">
                        <img t-att-src="'data:image/png;base64,' + props.data.ecf_qr_image"
                             width="120" height="120" alt="QR e-CF DGII"/>
                    </div>
                    <div t-if="props.data.ecf_codigo_seguridad"
                         class="pos-receipt-font-75 text-center do-pos-receipt-ecf-security">
                        Cód. Seguridad: <t t-esc="props.data.ecf_codigo_seguridad"/>
                    </div>
                </t>

                <br/>
            </t>
        </xpath>

        <!-- Encabezado de columnas DGII antes de las líneas -->
        <xpath expr="//OrderWidget" position="before">
            <t t-if="props.data.l10n_do_is_fiscal and props.data.l10n_do_fiscal_number">
                <div class="do-pos-receipt-titles">
                    <div>DESCRIPCIÓN</div>
                    <div class="text-end">ITBIS</div>
                    <div class="text-end">VALOR</div>
                </div>
            </t>
        </xpath>

        <!-- Pie fiscal DGII: subtotal gravado, ITBIS por tasa, total -->
        <xpath expr="//OrderWidget" position="after">
            <t t-if="props.data.l10n_do_is_fiscal and props.data.l10n_do_fiscal_number">
                <t t-set="ft" t-value="props.data.l10n_do_fiscal_totals"/>
                <div class="do-pos-receipt-fiscal-footer">

                    <div class="do-pos-receipt-footer-line">
                        <span>Subtotal gravado</span>
                        <span><t t-esc="ft.subtotal"/></span>
                    </div>

                    <t t-foreach="ft.itbis_groups" t-as="group" t-key="group.label">
                        <div class="do-pos-receipt-footer-line">
                            <span><t t-esc="group.label"/></span>
                            <span><t t-esc="group.amount"/></span>
                        </div>
                    </t>

                    <div class="do-pos-receipt-footer-line do-pos-receipt-footer-total">
                        <span>TOTAL</span>
                        <span><t t-esc="ft.total"/></span>
                    </div>

                </div>
            </t>
        </xpath>

    </t>

</templates>
