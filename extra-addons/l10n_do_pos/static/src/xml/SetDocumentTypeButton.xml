<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="l10n_do_pos.SetDocumentTypeButton">
        <div class="l10n-do-doc-type-button button" t-on-click="onClick">
            <!-- Icono: rayo para e-CF, documento para NCF -->
            <i t-if="isEcfType"
               class="fa fa-bolt me-1 l10n-do-ecf-icon"
               role="img"
               aria-label="Tipo de comprobante electrónico"
               title="Comprobante electrónico (e-CF)"/>
            <i t-else=""
               class="fa fa-file-text-o me-1"
               role="img"
               aria-label="Tipo de comprobante"
               title="Seleccionar tipo de comprobante"/>
            <span><t t-esc="currentDocTypeName"/></span>
            <!-- Badge NCF / e-CF -->
            <span t-if="isEcfType" class="l10n-do-type-badge l10n-do-type-badge--ecf">e-CF</span>
            <span t-elif="hasDocType" class="l10n-do-type-badge l10n-do-type-badge--ncf">NCF</span>
        </div>
    </t>

</templates>
