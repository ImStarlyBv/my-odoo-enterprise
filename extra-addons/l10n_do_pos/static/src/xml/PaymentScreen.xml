<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Inyectar SetDocumentTypeButton y ocultar botón Invoice en POS fiscal -->
    <t t-name="point_of_sale.PaymentScreenButtons"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('partner-button')]" position="after">
            <t t-if="pos.config.l10n_do_is_fiscal">
                <SetDocumentTypeButton/>
            </t>
            <t t-if="pos.config.l10n_do_is_fiscal and pos.config.l10n_do_allow_vendor_ncf">
                <VendorNcfButton/>
            </t>
        </xpath>
        <xpath expr="//button[hasclass('js_invoice')]" position="attributes">
            <attribute name="t-if">!pos.config.l10n_do_is_fiscal</attribute>
        </xpath>
    </t>

    <!-- Bloquear métodos de pago en modo Nota de Crédito -->
    <t t-name="point_of_sale.PaymentScreenMethods"
       t-inherit="point_of_sale.PaymentScreenMethods"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentmethods-container')]" position="attributes">
            <attribute name="t-attf-class">#{pos.isCreditNoteMode() ? 'no-clickeable' : ''}</attribute>
        </xpath>
    </t>

</templates>
