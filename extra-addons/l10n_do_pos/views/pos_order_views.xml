<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulario de pos.order: página de datos fiscales RD -->
    <record id="l10n_do_pos_view_pos_pos_form" model="ir.ui.view">
        <field name="name">l10n.do.pos.view.pos.pos.form</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">

            <!-- Botón Refund oculto cuando la orden no tiene NCF -->
            <xpath expr="//button[@name='refund']" position="attributes">
                <attribute name="invisible">
                    l10n_do_fiscal_number != False or state == 'draft' or has_refundable_lines == False
                </attribute>
            </xpath>

            <!-- Pestaña de datos fiscales -->
            <xpath expr="//notebook" position="inside">
                <page string="Datos fiscales"
                      invisible="not l10n_do_fiscal_number"
                      id="l10n_do_pos_page_fiscal_data">
                    <group>
                        <group>
                            <field name="l10n_latam_document_type_id" readonly="1"/>
                            <field name="l10n_do_fiscal_number" readonly="1"/>
                            <field name="l10n_do_ncf_expiration_date" readonly="1"/>
                            <field name="l10n_do_origin_ncf"
                                   invisible="not l10n_do_origin_ncf"
                                   readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Lista de pos.order: columna NCF -->
    <record id="l10n_do_pos_view_pos_order_tree" model="ir.ui.view">
        <field name="name">l10n.do.pos.view.pos.order.tree</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="l10n_do_fiscal_number" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
